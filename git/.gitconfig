[user]
	useConfigOnly = true

[include]
	path = ~/.gitconfig.local

[core]
	editor = vim
	quotepath = false
	autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = delta

[diff]
	algorithm = patience
	colorMoved = default

[log]
	date = local

[merge]
	tool = vimdiff
	log = true
	conflictstyle = zdiff3

[pull]
	ff = only

[init]
	defaultBranch = main

# named log formats, used by the graph log aliases below
[pretty]
	lg = format:%Cred%h %C(bold blue)<%an>%Creset %s %C(yellow)%d %Cgreen(%cr) %Cblue(%cd)%Creset
	l5 = format:%Cred%h%Creset - %C(yellow)%d%Creset %s %Cgreen(%cr)%Creset

[alias]
	# graph log
	lg = log --graph --pretty=lg --abbrev-commit
	lga = lg --all
	l5 = log --graph --pretty=l5 --abbrev-commit --date=relative --since=5day
	today = log --no-merges --after='yesterday 23:59'

	# status
	s = status --short --branch
	st = status

	# commit
	c = commit
	amend = commit --amend

	# summary of repo
	count = shortlog -sn --no-merges

	# delete local branches merged into the current branch
	sweep = "!f() { \
		b=$(git for-each-ref --merged=HEAD --format=\"%(refname:lstrip=2)\" refs/heads/ | rg -vxF -e main -e master -e dev -e \"$(git branch --show-current)\"); \
		[ -n \"$b\" ] || return 0; \
		echo \"$b\"; \
		printf \"Delete these branches? [y/N] \"; \
		read a; \
		case $a in [yY]) git branch -d -- $b;; esac; \
	}; f"

	# other
	co = checkout
	up = pull -p
	pl-fo = pull --ff-only
	mg-nf = merge --no-ff
	remotes = remote -v

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true    # use n and N to move between diff sections
	light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	line-numbers = true
